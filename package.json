{
  "name": "node-pptx-templater",
  "version": "3.0.0-alpha.0",
  "description": "Low-level OpenXML & Flat OPC PowerPoint template engine for Node.js, Express, Fastify, and serverless runtimes. Zero Office dependencies.",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    }
  },
  "bin": {
    "node-pptx-templater": "src/cli/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"showcase/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "benchmark": "node benchmarks/run.js",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:preview": "npx serve docs-site/out",
    "docs:data": "node scripts/generate-next-data.js",
    "docs:validate": "vitest run tests/unit/DocCoverage.test.js",
    "validate": "vitest run tests/unit/PackageSetup.test.js && node showcase/examples.js",
    "examples": "node showcase/examples.js",
    "prepublishOnly": "npm run lint && npm run test",
    "build": "tsup"
  },
